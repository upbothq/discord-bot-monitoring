{
	"name": "@upbothq/discord-bot-monitoring",
	"version": "0.0.23",
	"description": "Shard monitoring library for Discord bots built with discord.js",
	"homepage": "https://github.com/upbothq/discord-bot-monitoring#readme",
	"bugs": {
		"url": "https://github.com/upbothq/discord-bot-monitoring/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/upbothq/discord-bot-monitoring.git"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bunup",
		"dev": "bunup --watch",
		"prepare": "[ -d .git ] && bun simple-git-hooks || true",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"lint": "oxlint src",
		"lint:fix": "oxlint --fix src",
		"release": "bumpp --commit --push --tag",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"test:watch": "bun test --watch",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"ofetch": "^1.5.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@types/bun": "^1.3.5",
		"bumpp": "^10.3.2",
		"bunup": "^0.16.17",
		"discord.js": "^14.25.1",
		"javascript-obfuscator": "^5.3.0",
		"oxfmt": "^0.40.0",
		"oxlint": "^1.55.0",
		"oxlint-tsgolint": "^0.16.0",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"discord.js": "^14.0.0",
		"typescript": ">=4.5.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"simple-git-hooks": {
		"pre-commit": "bun run lint && bun run type-check"
	}
}
